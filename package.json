{
  "author": "Vajrang Miriyala",
  "build": {
    "appId": "com.sonara.app",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "app.js",
      "LICENSE",
      "README.md"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns"
    },
    "productName": "Sonara",
    "dmg": {
      "backgroundColor": "#141414"
    }
  },
  "description": "Sonara - a free, open-source music app for Mac",
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "license": "MIT",
  "main": "main.js",
  "name": "sonara",
  "scripts": {
    "dist": "electron-builder --mac --publish never",
    "start": "electron ."
  },
  "version": "0.5.0"
}
